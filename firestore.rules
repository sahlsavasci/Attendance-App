rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isValidAttendanceCreate(data) {
      return data.keys().hasAll(['userId', 'name', 'description', 'datetime', 'type'])
        && data.userId == request.auth.uid
        && isNonEmptyString(data.name, 100)
        && isNonEmptyString(data.description, 300)
        && isNonEmptyString(data.datetime, 100)
        && (data.type == 'attendance' || data.type == 'permission')
        && (!('nis' in data) || (data.nis is string && data.nis.size() <= 50))
        && (!('studentClass' in data) || (data.studentClass is string && data.studentClass.size() <= 50))
        && (!('approvalStatus' in data) || (data.approvalStatus in ['pending', 'approved', 'rejected']));
    }

    // Koleksi profil pengguna (Siswa & Wali Kelas)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isTeacher();
    }

    // Koleksi presensi dengan Identity Locking & RBAC
    match /attendance/{document} {
      // 1. Read: hanya diizinkan untuk pengguna yang telah terautentikasi
      allow read: if isSignedIn();

      // 2. Create: wajib login dan userId pada dokumen harus sama dengan request.auth.uid
      allow create: if isSignedIn()
        && isValidAttendanceCreate(request.resource.data);

      // 3. Update & Delete: siswa dilarang mengubah/menghapus catatan.
      // Hanya pengguna dengan role == 'teacher' pada dokumen users yang diizinkan.
      allow update, delete: if isTeacher();
    }
  }
}
